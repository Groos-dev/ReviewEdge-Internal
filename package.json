{
  "name": "mcp-codereview",
  "version": "1.0.0",
  "description": "MCP-based code review tool for Cursor/VS Code",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:server": "npm run build --workspace=packages/server",
    "build:extension": "npm run build --workspace=packages/extension",
    "dev:server": "npm run dev --workspace=packages/server",
    "dev:extension": "npm run watch --workspace=packages/extension",
    "lint": "biome check .",
    "lint:fix": "biome check . --write --verbose",
    "type-check": "tsc -p packages/server/tsconfig.json --noEmit && tsc -p packages/extension/tsconfig.json --noEmit",
    "package": "./scripts/package.sh",
    "package:extension": "cd packages/extension && npm run package"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@types/lodash": "^4.17.21",
    "@types/node": "^20.19.25",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "lodash": "^4.17.21"
  }
}
