{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["vscode", "node"],
    "moduleResolution": "node",
    "esModuleInterop": true
  },
  "include": [
    "src/**/*",
    "../server/src/protocol/**/*",
    "../server/src/core/**/*",
    "../server/src/types/**/*",
    "../ui/src/types/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
